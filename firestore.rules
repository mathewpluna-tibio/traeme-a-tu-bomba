rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Lista de amigos: solo la ve su dueño y solo la escriben las
      // Cloud Functions (Admin SDK se salta estas reglas).
      match /amigos/{amigoUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Solicitudes de amistad: las ven quien la envió y quien la recibe;
    // se crean/responden únicamente desde Cloud Functions.
    match /solicitudesAmistad/{id} {
      allow read: if request.auth != null
        && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow write: if false;
    }

    match /preferencias/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
